+// Contacts are gathered in parallel once per substep, then solved in stable cell/slot order.
+// Two float4 rows: normal.xy, other body code, gap; other body's COM lever.xy.
+RWStructuredBuffer<float4> _ContactOutput;
+StructuredBuffer<float4> _Contacts;
+RWStructuredBuffer<uint> _ContactCountOutput;
+StructuredBuffer<uint> _ContactCount;
+int _ContactBudget;
+#define CONTACT_SLOTS 32
+void StoreContact(uint cell,inout uint count,float2 n,int other,float gap,float2 lever)
+{
+    if(count>=(uint)_ContactBudget){InterlockedAdd(_ContactStats[4],1);InterlockedOr(_ContactStats[5],1);return;}
+    uint address=(cell*CONTACT_SLOTS+count)*2;
+    _ContactOutput[address]=float4(n,other,gap);_ContactOutput[address+1]=float4(lever,0,0);count++;
+}
+bool PotentialContact(float2 a,float aa,float2 b,float ab,float2 relative,out float2 normal,out float gap)
+{
+    gap=CellSeparation(a,aa,b,ab,normal);
+    if(gap<=.0001)return true;
+    float closing=-dot(relative,normal);float2 ignored;
+    return closing>0&&gap<=closing*_Delta+.0001&&CellSeparation(a,aa,b+relative*_Delta,ab,ignored)<=.0001;
+}
+[numthreads(64,1,1)]
+void PrepareCellForces(uint3 id:SV_DispatchThreadID)
+{
+    uint i=id.x;if(i>=_ContactCounts[0])return;Cell c=_Cells[i];float2 position=CellCenter(c)-.5;
+    float2 target=_MountedSuction!=0?World(float2(-12,0),_ShipPose[0]):_ForcePosition;
+    if(_Force>0&&distance(position,target)<80){c.velocity+=normalize(target-position+float2(.0001,0))*_Force*_Delta;c.flags=(c.flags&4)!=0?4:0;_Cells[i]=c;}
+}
+[numthreads(64,1,1)]
+void GatherCellContacts(uint3 id:SV_DispatchThreadID)
+{
+    uint i=id.x;if(i>=_ContactCounts[0])return;uint count=0;Cell cell=_Cells[i];bool cargo=(cell.flags&4)!=0;
+    float4 ship=_ShipPose[0];float angle=cargo?ship.z:0;float2 center=CellCenter(cell);
+    [loop] for(int domain=0;domain<2;domain++)
+    {
+        int2 at=(int2)floor(domain==1?Local(center,ship):center);
+        [loop] for(int y=-2;y<=2;y++)[loop] for(int x=-2;x<=2;x++)
+        {
+            int2 q=at+int2(x,y);if(domain==1?!LocalInside(q):!Inside(q))continue;
+            int slot=domain==1?_CargoOccupancy[CargoIndex(q)]:_Occupancy[Index(q)];
+            if(slot>(int)i+1)
+            {
+                Cell other=_Cells[slot-1];float2 n;float gap;
+                if(PotentialContact(CellCenter(other),(other.flags&4)!=0?ship.z:0,center,angle,cell.velocity-other.velocity,n,gap))StoreContact(i,count,n,slot-1,gap,0);
+            }
+            if(domain==0&&_Field[Address(q)]!=0)
+            {
+                float2 n;float gap;if(PotentialContact(float2(q)+.5,0,center,angle,cell.velocity,n,gap))StoreContact(i,count,n,-2,gap,0);
+            }
+        }
+    }
+    [loop] for(int body=-1;body<_FragmentCount;body++)
+    {
+        float4 pose=body<0?ship:_FragmentPose[body*2],mass=body<0?_ShipMass:_FragmentMass[body];
+        float4 motion=body<0?_ShipPose[1]:_FragmentPose[body*2+1];float2 com=World(mass.zw,pose);
+        int2 at=(int2)floor(Local(center,pose));float earliest=1e20,bestGap=0;float2 chosen=0,lever=0;
+        [loop] for(int y=-2;y<=2;y++)[loop] for(int x=-2;x<=2;x++)
+        {
+            int2 p=at+int2(x,y);if(!LocalInside(p)||(body<0?!HullAt(p):_FragmentHull[body*16384+CargoIndex(p)]==0))continue;
+            float2 hc=World(float2(p)+.5,pose),n;float gap=CellSeparation(hc,pose.z,center,angle,n);
+            float2 r=center-n*.5-com,relative=cell.velocity-SurfaceVelocity(motion,r);float closing=-dot(relative,n);
+            if(!PotentialContact(hc,pose.z,center,angle,relative,n,gap))continue;
+            float toi=max(0,gap)/max(closing,.000001);if(toi<earliest){earliest=toi;chosen=n;lever=r;bestGap=gap;}
+        }
+        if(earliest<1e20)StoreContact(i,count,chosen,body<0?-1:-3-body,bestGap,lever);
+    }
+    _ContactCountOutput[i]=count;InterlockedAdd(_ContactStats[6],count);
+}
+[numthreads(1,1,1)]
+void SolveShipCells(uint3 id:SV_DispatchThreadID)
+{
+    if(_ContactStats[5]!=0)return;
+    uint iterations=_ContactCounts[0]>1?16:1;
+    [loop] for(uint iteration=0;iteration<iterations;iteration++)
+    {
+        ShipAnchorImpulses();
+        [loop] for(uint i=0;i<_ContactCounts[0];i++)
+        {
+            Cell cell=_Cells[i];float inverse=1/_Properties[cell.material].y;
+            [loop] for(uint contactIndex=0;contactIndex<_ContactCount[i];contactIndex++)
+            {
+                uint address=(i*CONTACT_SLOTS+contactIndex)*2;float4 contact=_Contacts[address];float2 n=contact.xy,r=_Contacts[address+1].xy;
+                int other=(int)contact.z;float4 v=0,mass=0;
+                if(other>=0){v=float4(_Cells[other].velocity,0,0);mass.x=1/_Properties[_Cells[other].material].y;}
+                else if(other==-1){v=_ShipPose[1];mass=_ShipMass;}
+                else if(other<-2){v=_FragmentNextPose[(-3-other)*2+1];mass=_FragmentMass[-3-other];}
+                float closing=-dot(cell.velocity-SurfaceVelocity(v,r),n);if(closing<=0)continue;
+                float arm=Cross2(r,n),j=closing/(inverse+mass.x+arm*arm*mass.y);
+                cell.velocity+=n*(j*inverse);cell.flags=(cell.flags&4)!=0?4:0;v.xy-=n*(j*mass.x);v.z-=arm*j*mass.y;
+                if(other>=0){Cell target=_Cells[other];target.velocity=v.xy;target.flags=(target.flags&4)!=0?4:0;_Cells[other]=target;}
+                else if(other==-1)_ShipPose[1]=v;else if(other<-2)_FragmentNextPose[(-3-other)*2+1]=v;
+                _ContactStats[0]++;
+                if(iteration==0&&other<0&&other!=-2&&contact.w<.0001&&contact.w>-.001)
+                {
+                    bool cargo=(cell.flags&4)!=0;float2 correction=(cargo?Rotate(n,-_ShipPose[0].z):n)*(.0001-contact.w),target=cell.position+correction;
+                    if(cargo?CargoFree(target,i):Free(target,i))
+                    {
+                        if(cargo)_CargoOccupancy[CargoIndex((int2)floor(cell.position))]=0;else _Occupancy[Index((int2)floor(cell.position))]=0;
+                        cell.position=target;
+                        if(cargo)_CargoOccupancy[CargoIndex((int2)floor(cell.position))]=(int)i+1;else _Occupancy[Index((int2)floor(cell.position))]=(int)i+1;
+                        _ContactStats[3]++;
+                    }
+                }
+            }
+            _Cells[i]=cell;
+        }
+    }
+}
