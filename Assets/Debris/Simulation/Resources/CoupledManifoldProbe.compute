#pragma kernel BuildManifolds
#pragma kernel BuildRows
#pragma kernel MarkCandidates
#pragma kernel ScanCandidateLocal
#pragma kernel ScanCandidateBlocks
#pragma kernel ScatterCandidates
#pragma kernel PrepareCandidateArgs
#pragma kernel ResetValidationFacts
#pragma kernel PrepareValidationArgs
#pragma kernel GatherValidationFacts
#pragma kernel ValidatePrimitiveClasses

// V2-1 convex pair narrow phase. The broad phase supplies primitive pairs;
// output is one or two distinct points on the winning SAT reference face.
struct BoxPair
{
    float2 aCenter,aHalf;
    float aAngle;
    uint aIdentity;
    float2 bCenter,bHalf;
    float bAngle;
    uint bIdentity;
};
struct Manifold
{
    uint count,referenceFace;
    float2 normal;
    float2 point0,point1;
    float gap0,gap1;
    uint incidentFace,provenance0,provenance1;
};
struct Body { float2 center; float inverseMass; float inverseInertia; };
struct Row { uint a,b; float2 contactPoint,direction; float inverseRoot,gap; };
struct Primitive
{
    float2 center,half;
    float angle;
    uint endpoint;
    float2 sweep;
    uint anchored,kind,faceIndex,unionIndex,contactClass,featureId;
};
struct Group
{
    float2 unionCenter;
    float unionAngle;
    uint patchStart,patchCount,firstQuery,queryCount,reserved;
};
StructuredBuffer<BoxPair> _Pairs;
RWStructuredBuffer<Manifold> _Manifolds;
StructuredBuffer<Body> _Bodies;
RWStructuredBuffer<Row> _Rows;
uint _PairCount;
uint _BodyCount;
float _Margin;
StructuredBuffer<uint> _CandidateCount;
StructuredBuffer<uint2> _CandidateIndices;
StructuredBuffer<Primitive> _SourcePrimitives;
StructuredBuffer<Group> _UnionGroups;
RWStructuredBuffer<Manifold> _UnionManifolds;
RWStructuredBuffer<uint> _UnionManifoldSlots,_UnionManifoldCount;
RWStructuredBuffer<uint> _CandidateMasks,_CandidateLocalStarts;
RWStructuredBuffer<uint> _CandidateBlockSums,_CandidateBlockStarts;
RWStructuredBuffer<BoxPair> _CompactPairs;
RWStructuredBuffer<uint2> _CompactIndices;
RWStructuredBuffer<Manifold> _CompactManifolds;
RWStructuredBuffer<uint> _CompactCount,_CompactFault;
RWStructuredBuffer<uint> _CandidateMarkArgs,_CandidateScanArgs,_CandidateScatterArgs;
RWStructuredBuffer<uint> _ValidationFacts,_ValidationArgs;
StructuredBuffer<Manifold> _ScatterUnionManifolds;
StructuredBuffer<uint> _ScatterUnionManifoldSlots,_ScatterCandidateMasks;
StructuredBuffer<uint> _ScatterCandidateLocalStarts,_ScatterCandidateBlockStarts;
uint _CandidateCapacity,_CompactCapacity;
uint _PrimitiveCount,_EnableUnion;
uint _UnionGroupCount;
uint _UnionManifoldCapacity;
groupshared uint _CandidateScan[256];

[numthreads(1,1,1)]
void PrepareCandidateArgs(uint id:SV_DispatchThreadID)
{
    if(id!=0)return;
    uint active=min(_CandidateCount[0],_CandidateCapacity);
    _CompactFault[0]=0;
    _UnionManifoldCount[0]=0;
    uint rows=(active+63)/64,blocks=(active+255)/256;
    _CandidateMarkArgs[0]=max(1u,rows);
    _CandidateMarkArgs[1]=1;_CandidateMarkArgs[2]=1;_CandidateMarkArgs[3]=rows;
    _CandidateScanArgs[0]=max(1u,blocks);
    _CandidateScanArgs[1]=1;_CandidateScanArgs[2]=1;_CandidateScanArgs[3]=blocks;
    _CandidateScatterArgs[0]=max(1u,rows);
    _CandidateScatterArgs[1]=1;_CandidateScatterArgs[2]=1;_CandidateScatterArgs[3]=rows;
}

float2 rotate2(float2 p,float angle)
{
    float s,c;sincos(angle,s,c);
    return float2(c*p.x-s*p.y,s*p.x+c*p.y);
}
float2 vertex(float2 center,float2 half,float angle,uint index)
{
    float2 local=index==0?float2(-half.x,-half.y):
        index==1?float2(half.x,-half.y):
        index==2?float2(half.x,half.y):float2(-half.x,half.y);
    return center+rotate2(local,angle);
}
float2 faceNormal(float2 start,float2 end)
{
    float2 edge=end-start;
    return normalize(float2(edge.y,-edge.x));
}
BoxPair primitivePair(Primitive a,Primitive b)
{
    BoxPair pair;
    pair.aCenter=a.center;pair.aHalf=a.half;
    pair.aAngle=a.angle;pair.aIdentity=a.endpoint;
    pair.bCenter=b.center;pair.bHalf=b.half;
    pair.bAngle=b.angle;pair.bIdentity=b.endpoint;
    return pair;
}
Manifold EvaluateManifold(BoxPair pair)
{
    Manifold result=(Manifold)0;
    if(!all(isfinite(float4(pair.aCenter,pair.aHalf)))||
       !all(isfinite(float4(pair.bCenter,pair.bHalf)))||
       !isfinite(pair.aAngle)||!isfinite(pair.bAngle)||
       any(pair.aHalf<=0)||any(pair.bHalf<=0))
    {return result;}
    float2 a[4],b[4];
    for(uint i=0;i<4;i++)
    {
        a[i]=vertex(pair.aCenter,pair.aHalf,pair.aAngle,i);
        b[i]=vertex(pair.bCenter,pair.bHalf,pair.bAngle,i);
    }
    float best=-3.4e38;uint selected=0;
    for(uint face=0;face<8;face++)
    {
        uint edge=face&3;
        float2 start=face<4?a[edge]:b[edge];
        float2 end=face<4?a[(edge+1)&3]:b[(edge+1)&3];
        float2 n=faceNormal(start,end);
        float maximum=-3.4e38,minimum=3.4e38;
        for(uint i=0;i<4;i++)
        {
            float2 from=face<4?a[i]:b[i],to=face<4?b[i]:a[i];
            maximum=max(maximum,dot(from,n));minimum=min(minimum,dot(to,n));
        }
        float gap=minimum-maximum;
        if(gap>best+1e-6 || (abs(gap-best)<=1e-6 && face<selected))
        {best=gap;selected=face;}
    }
    if(best>_Margin+1e-6)return result;
    bool swap=selected>=4;uint edge=selected&3;
    float2 r0=swap?b[edge]:a[edge],r1=swap?b[(edge+1)&3]:a[(edge+1)&3];
    float2 outward=faceNormal(r0,r1);
    float length=distance(r0,r1);
    float2 tangent=(r1-r0)/length;
    uint incident=0;float anti=3.4e38;
    for(uint i=0;i<4;i++)
    {
        float2 start=swap?a[i]:b[i],end=swap?a[(i+1)&3]:b[(i+1)&3];
        float dotNormal=dot(faceNormal(start,end),outward);
        if(dotNormal<anti){anti=dotNormal;incident=i;}
    }
    float2 q0=swap?a[incident]:b[incident];
    float2 q1=swap?a[(incident+1)&3]:b[(incident+1)&3];
    float u0=dot(q0-r0,tangent),u1=dot(q1-r0,tangent);
    float lo=max(0,min(u0,u1)),hi=min(length,max(u0,u1));
    if(hi<lo-1e-6)return result;
    result.referenceFace=selected;
    result.incidentFace=incident;
    result.normal=swap?-outward:outward;
    for(uint contactPoint=0;contactPoint<2;contactPoint++)
    {
        float u=contactPoint==0?lo:hi;
        float fraction=abs(u1-u0)<1e-8?0:(u-u0)/(u1-u0);
        float2 incidentPoint=lerp(q0,q1,fraction),referencePoint=r0+tangent*u;
        float gap=dot(incidentPoint-referencePoint,outward);
        float2 midpoint=(incidentPoint+referencePoint)*.5;
        if(gap>_Margin+1e-6)continue;
        if(result.count!=0 && distance(result.point0,midpoint)<1e-5)continue;
        uint provenance=abs(fraction)<=1e-6?0u:
            abs(fraction-1)<=1e-6?1u:abs(u)<=1e-6?2u:3u;
        if(result.count==0)
        {result.point0=midpoint;result.gap0=gap;result.provenance0=provenance;}
        else
        {result.point1=midpoint;result.gap1=gap;result.provenance1=provenance;}
        result.count++;
    }
    return result;
}

[numthreads(64,1,1)]
void BuildManifolds(uint id:SV_DispatchThreadID)
{
    if(id>=_PairCount)return;
    _Manifolds[id]=EvaluateManifold(_Pairs[id]);
}

[numthreads(64,1,1)]
void MarkCandidates(uint id:SV_DispatchThreadID)
{
    uint count=min(_CandidateCount[0],_CandidateCapacity);
    if(id>=count)return;
    if(_EnableUnion!=0)_UnionManifoldSlots[id]=0xffffffffu;
    Manifold result=(Manifold)0;
    uint2 indices=_CandidateIndices[id];
    if(indices.x>=_PrimitiveCount||indices.y>=_PrimitiveCount)
    {uint old;InterlockedOr(_CompactFault[0],4u,old);}
    else
    {
        Primitive a=_SourcePrimitives[indices.x],b=_SourcePrimitives[indices.y];
        if(a.kind==0&&b.kind==0)result=EvaluateManifold(primitivePair(a,b));
        else if(_EnableUnion==0)
        {uint old;InterlockedOr(_CompactFault[0],4u,old);}
    }
    _CandidateMasks[id]=result.count>0?1:0;
}

[numthreads(256,1,1)]
void ScanCandidateLocal(uint3 group:SV_GroupID,uint3 thread:SV_GroupThreadID)
{
    uint lane=thread.x,id=group.x*256+lane;
    uint count=min(_CandidateCount[0],_CandidateCapacity);
    uint active=id<count?_CandidateMasks[id]:0;
    _CandidateScan[lane]=active;
    GroupMemoryBarrierWithGroupSync();
    for(uint width=1;width<256;width<<=1)
    {
        uint prior=lane>=width?_CandidateScan[lane-width]:0;
        GroupMemoryBarrierWithGroupSync();
        _CandidateScan[lane]+=prior;
        GroupMemoryBarrierWithGroupSync();
    }
    if(id<count)_CandidateLocalStarts[id]=_CandidateScan[lane]-active;
    if(lane==255)_CandidateBlockSums[group.x]=_CandidateScan[lane];
}

[numthreads(1,1,1)]
void ScanCandidateBlocks(uint id:SV_DispatchThreadID)
{
    if(id!=0)return;
    uint total=0;
    uint active=min(_CandidateCount[0],_CandidateCapacity);
    uint blocks=max(1u,(active+255)/256);
    for(uint block=0;block<blocks;block++)
    {
        _CandidateBlockStarts[block]=total;
        total+=_CandidateBlockSums[block];
    }
    _CompactCount[0]=total;
    uint existing=_CompactFault[0];
    _CompactFault[0]=existing|(_CandidateCount[0]>_CandidateCapacity?1u:0u)|
        (total>_CompactCapacity?2u:0u);
}

[numthreads(64,1,1)]
void ScatterCandidates(uint id:SV_DispatchThreadID)
{
    if(id>=min(_CandidateCount[0],_CandidateCapacity)||_ScatterCandidateMasks[id]==0)return;
    uint output=_ScatterCandidateBlockStarts[id/256]+_ScatterCandidateLocalStarts[id];
    if(output>=_CompactCapacity)return;
    uint2 indices=_CandidateIndices[id];
    Primitive a=_SourcePrimitives[indices.x],b=_SourcePrimitives[indices.y];
    BoxPair pair=primitivePair(a,b);
    Manifold contact=(Manifold)0;
    if(a.kind==0&&b.kind==0)contact=EvaluateManifold(pair);
    else
    {
        uint slot=_ScatterUnionManifoldSlots[id];
        if(slot>=_UnionManifoldCapacity)
        {uint old;InterlockedOr(_CompactFault[0],4u,old);return;}
        contact=_ScatterUnionManifolds[slot];
    }
    if(contact.count==0)
    {uint old;InterlockedOr(_CompactFault[0],4u,old);return;}
    if(a.kind==1&&b.kind==0)
    {
        pair=primitivePair(b,a);
        if(a.unionIndex>=_UnionGroupCount)
        {uint old;InterlockedOr(_CompactFault[0],4u,old);return;}
        Group group=_UnionGroups[a.unionIndex];
        pair.bCenter=group.unionCenter;pair.bAngle=group.unionAngle;
    }
    else if(a.kind==0&&b.kind==1)
    {
        if(b.unionIndex>=_UnionGroupCount)
        {uint old;InterlockedOr(_CompactFault[0],4u,old);return;}
        Group group=_UnionGroups[b.unionIndex];
        pair.bCenter=group.unionCenter;pair.bAngle=group.unionAngle;
    }
    else if(a.kind==1&&b.kind==1)
    {
        if(a.unionIndex>=_UnionGroupCount||b.unionIndex>=_UnionGroupCount)
        {uint old;InterlockedOr(_CompactFault[0],4u,old);return;}
        Group first=_UnionGroups[a.unionIndex],second=_UnionGroups[b.unionIndex];
        pair.aCenter=first.unionCenter;pair.aAngle=first.unionAngle;
        pair.bCenter=second.unionCenter;pair.bAngle=second.unionAngle;
    }
    _CompactPairs[output]=pair;
    _CompactIndices[output]=indices;
    _CompactManifolds[output]=contact;
}

[numthreads(1,1,1)]
void ResetValidationFacts(uint id:SV_DispatchThreadID)
{
    if(id!=0)return;
    _ValidationFacts[0]=0;
    _ValidationFacts[1]=0;
    _ValidationFacts[2]=0xffffffffu;
    _ValidationFacts[3]=0;
    _ValidationFacts[4]=0;
    _ValidationFacts[5]=0xffffffffu;
    _ValidationFacts[6]=0;
    _ValidationFacts[7]=0;
}

[numthreads(64,1,1)]
void ValidatePrimitiveClasses(uint id:SV_DispatchThreadID)
{
    if(id>=_PrimitiveCount)return;
    Primitive p=_SourcePrimitives[id];
    if(p.contactClass<1||p.contactClass>2||
       (p.kind==1&&p.contactClass!=2))
    {uint old;InterlockedAdd(_ValidationFacts[4],1,old);}
}

[numthreads(1,1,1)]
void PrepareValidationArgs(uint id:SV_DispatchThreadID)
{
    if(id!=0)return;
    uint groups=(min(_CompactCount[0],_CompactCapacity)+63)/64;
    _ValidationArgs[0]=max(1u,groups);
    _ValidationArgs[1]=1;_ValidationArgs[2]=1;
    _ValidationArgs[3]=groups;
}

[numthreads(64,1,1)]
void GatherValidationFacts(uint id:SV_DispatchThreadID)
{
    if(id>=min(_CompactCount[0],_CompactCapacity))return;
    Manifold contact=_CompactManifolds[id];
    uint2 pair=_CompactIndices[id];
    if(pair.x>=_PrimitiveCount||pair.y>=_PrimitiveCount||
       contact.count==0||contact.count>2||
       !all(isfinite(contact.normal)))
    {uint old;InterlockedAdd(_ValidationFacts[4],1,old);return;}
    Primitive a=_SourcePrimitives[pair.x],b=_SourcePrimitives[pair.y];
    if(a.contactClass<1||a.contactClass>2||
       b.contactClass<1||b.contactClass>2||
       (a.kind==1&&a.contactClass!=2)||
       (b.kind==1&&b.contactClass!=2))
    {uint old;InterlockedAdd(_ValidationFacts[4],1,old);return;}
    bool grainPair=a.contactClass==1&&b.contactClass==1;
    float hardBound=grainPair?.01:.001;
    for(uint contactPoint=0;contactPoint<contact.count;contactPoint++)
    {
        float gap=contactPoint==0?contact.gap0:contact.gap1;
        float2 position=contactPoint==0?contact.point0:contact.point1;
        if(!isfinite(gap)||!all(isfinite(position)))
        {uint old;InterlockedAdd(_ValidationFacts[4],1,old);continue;}
        uint old;
        InterlockedAdd(_ValidationFacts[7],1,old);
        if(gap>=0)continue;
        InterlockedMax(_ValidationFacts[grainPair?0:1],asuint(-gap),old);
        InterlockedMin(_ValidationFacts[2],id,old);
        InterlockedAdd(_ValidationFacts[3],1,old);
        if(-gap>hardBound)
        {
            InterlockedMin(_ValidationFacts[5],id,old);
            InterlockedAdd(_ValidationFacts[6],1,old);
        }
    }
}

float cross2(float2 a,float2 b){return a.x*b.y-a.y*b.x;}

[numthreads(64,1,1)]
void BuildRows(uint id:SV_DispatchThreadID)
{
    if(id>=_PairCount)return;
    BoxPair pair=_Pairs[id];Manifold manifold=_Manifolds[id];
    Row empty=(Row)0;
    for(uint slot=0;slot<4;slot++)_Rows[4*id+slot]=empty;
    if(pair.aIdentity>=_BodyCount||pair.bIdentity>=_BodyCount||
       pair.aIdentity==pair.bIdentity)return;
    Body a=_Bodies[pair.aIdentity],b=_Bodies[pair.bIdentity];
    for(uint contactPoint=0;contactPoint<min(2u,manifold.count);contactPoint++)
    {
        float2 position=contactPoint==0?manifold.point0:manifold.point1;
        float gap=contactPoint==0?manifold.gap0:manifold.gap1;
        for(uint axis=0;axis<2;axis++)
        {
            float2 direction=axis==0?manifold.normal:float2(-manifold.normal.y,manifold.normal.x);
            float angularA=cross2(position-a.center,direction);
            float angularB=cross2(position-b.center,direction);
            float diagonal=a.inverseMass+b.inverseMass+
                a.inverseInertia*angularA*angularA+b.inverseInertia*angularB*angularB;
            if(!(diagonal>0)||!isfinite(diagonal))continue;
            Row row=(Row)0;
            row.a=pair.aIdentity;row.b=pair.bIdentity;
            row.contactPoint=position;row.direction=direction;
            row.inverseRoot=rsqrt(diagonal);row.gap=gap;
            _Rows[4*id+2*contactPoint+axis]=row;
        }
    }
}
